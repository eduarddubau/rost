{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (Console)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "/tmp/build/bin/Debug/net10.0/Backend.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "launchSettingsProfile": null,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://0.0.0.0:8080"
      },
      "sourceFileMap": {
        "/workspaces/rost": "${workspaceFolder}"
      },
      "symbolOptions": {
        "searchPaths": ["/tmp/build/bin/Debug/net10.0"],
        "searchMicrosoftSymbolServer": false
      },
      "logging": {
        "moduleLoad": true,
        "diagnosticsLog": {
          "protocolMessages": false
        }
      },
      "justMyCode": false
    },
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "justMyCode": false,
      "sourceFileMap": {
        "/workspaces/rost": "${workspaceFolder}"
      },
      "symbolOptions": {
        "searchPaths": ["/tmp/build/bin/Debug/net10.0"],
        "searchMicrosoftSymbolServer": false
      }
    }
  ]
}
