# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# POSTGRES_PASSWORD is only read when Postgres initialises an empty data
# directory. Changing it later has no effect until the volume is recreated
# (docker/podman compose down -v).

POSTGRES_PASSWORD=

# Host=db is the compose service name and resolves only inside the container
# network. A database client on your own machine connects to 127.0.0.1:5432.
DB_CONNECTION_STRING=Host=db;Port=5432;Database=app_db;Username=admin;Password=

# Signing key for HS512 — must be at least 64 characters.
# Generate one with: openssl rand -base64 48
Jwt__Key=
Jwt__Issuer=rost
Jwt__Audience=rost
Jwt__DurationInMinutes=15
